{% set option_form = hookable_metadata.context.option_form %}

{% hook 'sylius.shop.product.show.before_add_to_cart' %}
    {% for option_form in form.cartItem.variant %}
        {% if monsieurbiz_advancedoption_has_renderer(option_form.vars.data.option) %}
            {{ monsieurbiz_advancedoption_form_row(option_form) }}
        {% else %}
            {{ form_row(option_form, {
                'attr': {
                    'data-option': option_form.vars.name,
                    'data-action':'product#selectVariant'
                }
            }) }}
        {% endif %}
    {% endfor %}
{% endhook %}
